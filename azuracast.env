# AzuraCast Environment Configuration
# This file contains all the environment variables for AzuraCast

# Application Environment
AZURACAST_APP_ENV=production

# Database Configuration
AZURACAST_DB_HOST=localhost
AZURACAST_DB_PORT=3306
AZURACAST_DB_USERNAME=azuracast
AZURACAST_DB_PASSWORD=azuracast
AZURACAST_DB_DATABASE=azuracast

# Redis Configuration
AZURACAST_REDIS_HOST=localhost
AZURACAST_REDIS_PORT=6379

# Station Configuration
AZURACAST_STATION_NAME=AudioStreamer Radio
AZURACAST_STATION_DESCRIPTION=Custom radio station with metadata
AZURACAST_STATION_GENRE=Custom

# Streaming Configuration
AZURACAST_STREAM_PORT=8000
AZURACAST_WEB_PORT=80

# Security
AZURACAST_ADMIN_EMAIL=admin@audiostreamer.com
AZURACAST_ADMIN_PASSWORD=admin123

# Performance
AZURACAST_MAX_UPLOAD_SIZE=100M
AZURACAST_MEMORY_LIMIT=512M
