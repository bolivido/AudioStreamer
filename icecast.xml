<icecast>
    <location>AudioStreamer</location>
    <admin>admin@localhost</admin>
    
    <!-- Authentication section -->
    <authentication>
        <source-password>changeme</source-password>
        <relay-password>changeme</relay-password>
        <admin-user>admin</admin-user>
        <admin-password>admin123</admin-password>
    </authentication>
    
    <!-- Hostname and port settings -->
    <hostname>0.0.0.0</hostname>
    <port>8000</port>
    
    <!-- Web interface settings -->
    <web-port>8001</web-port>
    <web-hostname>0.0.0.0</web-hostname>
    
    <!-- Logging - use writable paths -->
    <logdir>/opt/shoutcast/logs</logdir>
    <logfile>icecast.log</logfile>
    <loglevel>4</loglevel>
    
    <!-- Security -->
    <security>
        <chroot>0</chroot>
        <changeowner>
            <user>icecast</user>
            <group>icecast</group>
        </changeowner>
    </security>
    
    <!-- Mount points -->
    <mount>
        <mount-name>/stream</mount-name>
        <username>source</username>
        <password>changeme</password>
        <max-listeners>100</max-listeners>
        <dump-file>/opt/shoutcast/logs/dump-1.ogg</dump-file>
        <fallback-mount>/silence.ogg</fallback-mount>
        <fallback-override>1</fallback-override>
        <fallback-when-full>1</fallback-override>
        <intro>/opt/shoutcast/content/intro.ogg</intro>
        <hidden>0</hidden>
        <public>1</public>
        <stream-name>AudioStreamer Radio</stream-name>
        <stream-description>Custom radio stream with metadata</stream-description>
        <stream-url>https://your-railway-app.railway.app</stream-url>
        <stream-genre>Custom</stream-genre>
        <stream-bitrate>128</stream-bitrate>
        <stream-samplerate>44100</stream-samplerate>
        <stream-channels>2</stream-channels>
    </mount>
    
    <!-- HTTP headers for metadata -->
    <http-headers>
        <header name="Access-Control-Allow-Origin" value="*" />
        <header name="Access-Control-Allow-Headers" value="Origin, X-Requested-With, Content-Type, Accept" />
        <header name="Access-Control-Allow-Methods" value="GET, POST, OPTIONS" />
    </http-headers>
</icecast>
